{
  "name": "advanced-texteditor-md",
  "version": "0.1.0",
  "description": "A dependency-free WYSIWYG editor that stores Markdown. Mentions, chips, images and uploads, tables, task lists, LaTeX, code highlighting, custom syntax and plugins. Tailwind-friendly and themeable.",
  "keywords": [
    "accessible",
    "code highlighting",
    "collapsible",
    "contenteditable",
    "custom syntax",
    "drag and drop",
    "editor",
    "embeds",
    "framework agnostic",
    "gfm",
    "github flavored markdown",
    "image resize",
    "latex",
    "lazy loading",
    "lightbox",
    "link preview",
    "markdown",
    "markdown editor",
    "markdown wysiwyg editor",
    "markdown-wysiwyg",
    "mathml",
    "mention",
    "mentions",
    "plugin",
    "rich text",
    "rich text editor",
    "ssr",
    "tailwind",
    "text editor",
    "themeable",
    "typescript",
    "vanilla js",
    "web editor",
    "wysiwyg",
    "wysiwyg-markdown",
    "zero dependencies"
  ],
  "homepage": "https://faraasat.github.io/advanced-texteditor-md",
  "bugs": {
    "url": "https://github.com/faraasat/advanced-texteditor-md/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/advanced-texteditor-md.git"
  },
  "license": "MIT",
  "author": "Farasat Ali <63093876+faraasat@users.noreply.github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faraasat"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser.d.ts",
        "default": "./dist/parser.js"
      },
      "require": {
        "types": "./dist/parser.d.cts",
        "default": "./dist/parser.cjs"
      }
    },
    "./render": {
      "import": {
        "types": "./dist/render.d.ts",
        "default": "./dist/render.js"
      },
      "require": {
        "types": "./dist/render.d.cts",
        "default": "./dist/render.cjs"
      }
    },
    "./math": {
      "import": {
        "types": "./dist/math.d.ts",
        "default": "./dist/math.js"
      },
      "require": {
        "types": "./dist/math.d.cts",
        "default": "./dist/math.cjs"
      }
    },
    "./highlight": {
      "import": {
        "types": "./dist/highlight.d.ts",
        "default": "./dist/highlight.js"
      },
      "require": {
        "types": "./dist/highlight.d.cts",
        "default": "./dist/highlight.cjs"
      }
    },
    "./uploaders": {
      "import": {
        "types": "./dist/uploaders.d.ts",
        "default": "./dist/uploaders.js"
      },
      "require": {
        "types": "./dist/uploaders.d.cts",
        "default": "./dist/uploaders.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./mentions": {
      "import": {
        "types": "./dist/mentions.d.ts",
        "default": "./dist/mentions.js"
      },
      "require": {
        "types": "./dist/mentions.d.cts",
        "default": "./dist/mentions.cjs"
      }
    },
    "./paste": {
      "import": {
        "types": "./dist/paste.d.ts",
        "default": "./dist/paste.js"
      },
      "require": {
        "types": "./dist/paste.d.cts",
        "default": "./dist/paste.cjs"
      }
    },
    "./link-preview": {
      "import": {
        "types": "./dist/link-preview.d.ts",
        "default": "./dist/link-preview.js"
      },
      "require": {
        "types": "./dist/link-preview.d.cts",
        "default": "./dist/link-preview.cjs"
      }
    },
    "./embeds": {
      "import": {
        "types": "./dist/embeds.d.ts",
        "default": "./dist/embeds.js"
      },
      "require": {
        "types": "./dist/embeds.d.cts",
        "default": "./dist/embeds.cjs"
      }
    },
    "./lightbox": {
      "import": {
        "types": "./dist/lightbox.d.ts",
        "default": "./dist/lightbox.js"
      },
      "require": {
        "types": "./dist/lightbox.d.cts",
        "default": "./dist/lightbox.cjs"
      }
    },
    "./highlight/*": {
      "import": {
        "types": "./dist/highlight/*.d.ts",
        "default": "./dist/highlight/*.js"
      },
      "require": {
        "types": "./dist/highlight/*.d.cts",
        "default": "./dist/highlight/*.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./style.min.css": "./dist/style.min.css",
    "./plugins.css": "./dist/plugins.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/CUSTOM_SYNTAX.md",
    "docs/PLUGINS.md",
    "docs/THEMING.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/strip-bare-imports.mjs && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs",
    "test:e2e": "playwright test",
    "release": "standard-version",
    "prepublishOnly": "npm run typecheck && vitest run && npm run build && npm run size && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "site:screenshots": "node scripts/site-screenshots.mjs",
    "test:site": "playwright test -c playwright.site.config.ts",
    "site:install": "npm --prefix site ci"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "typesVersions": {
    "*": {
      "parser": [
        "./dist/parser.d.ts"
      ],
      "render": [
        "./dist/render.d.ts"
      ],
      "math": [
        "./dist/math.d.ts"
      ],
      "highlight": [
        "./dist/highlight.d.ts"
      ],
      "highlight/*": [
        "./dist/highlight/*.d.ts"
      ],
      "uploaders": [
        "./dist/uploaders.d.ts"
      ],
      "plugins": [
        "./dist/plugins.d.ts"
      ],
      "mentions": [
        "./dist/mentions.d.ts"
      ],
      "paste": [
        "./dist/paste.d.ts"
      ],
      "link-preview": [
        "./dist/link-preview.d.ts"
      ],
      "embeds": [
        "./dist/embeds.d.ts"
      ],
      "lightbox": [
        "./dist/lightbox.d.ts"
      ]
    }
  }
}
